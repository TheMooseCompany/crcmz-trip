# CRCMZ Trip — environment configuration (placeholders only, never real values)
# Copy to .env locally, or set these in Coolify → Environment Variables.

# Zitadel OIDC — Authorization Code flow.
# Issuer URL of the Zitadel instance, e.g. https://auth.example.com
ZITADEL_ISSUER=https://your-zitadel-instance.example.com
# Client ID of the OIDC application registered in Zitadel (Web app, code flow).
ZITADEL_CLIENT_ID=000000000000000000
# Client secret for that application. Treat like a password.
ZITADEL_CLIENT_SECRET=replace-with-the-real-secret

# Random string used to sign the session cookie. Generate a long one, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Public origin the app is reached at. The OIDC redirect URI is built from it:
#   <BASE_URL>/auth/callback   →   https://trip.crcmz.me/auth/callback
# Register that exact URI in the Zitadel application's redirect URIs.
BASE_URL=https://trip.crcmz.me

# Port the app listens on (Coolify sets/routs this; default 3000).
PORT=3000
